# MongoDB Atlas connection string for the cabinet-studio database.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/cabinet-studio

# Generate a random secret of at least 32 characters. Keep it private.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Optional server-side AI providers. Never prefix these with NEXT_PUBLIC_.
GROQ_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Required to enable POST /api/seed. Use a separate random secret.
SEED_SECRET=replace-with-a-separate-random-seed-secret
ADMIN_EMAIL=admin@cabinetstudio.in
ADMIN_SEED_PASSWORD=
